# Application
NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
AUDIT_HMAC_KEY=replace-with-an-independent-long-random-secret

# Supabase PostgreSQL
# Use the pooled URL at runtime and the direct URL for migrations.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Cloudflare R2 (private bucket only)
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-bucket-scoped-access-key
R2_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret
R2_BUCKET_NAME=trustvault-documents
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com

