# Application
NODE_ENV=development
APP_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Generate each value independently with: openssl rand -base64 32
AUDIT_HMAC_KEY_VERSION=1
AUDIT_HMAC_KEYS={"1":"replace-with-independent-base64-audit-key"}

# Demo users (used only by `npm run db:seed:demo`)
DEMO_ADMIN_EMAIL=admin@trustvault.local
DEMO_ADMIN_PASSWORD=replace-with-a-strong-demo-password
DEMO_OWNER_EMAIL=owner@trustvault.local
DEMO_OWNER_PASSWORD=replace-with-a-strong-demo-password
DEMO_VIEWER_EMAIL=viewer@trustvault.local
DEMO_VIEWER_PASSWORD=replace-with-a-strong-demo-password

# Supabase PostgreSQL
# This persistent Next.js server uses the session pooler on port 5432.
DATABASE_URL=postgresql://user.project-ref:password@region.pooler.supabase.com:5432/postgres
# Prefer the direct project URL for migrations; use the session pooler when
# the machine cannot reach Supabase's IPv6 direct endpoint.
DIRECT_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# Cloudflare R2 (private bucket only)
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-bucket-scoped-access-key
R2_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret
R2_BUCKET_NAME=trustvault-documents
# Use default, eu, fedramp, or us. The endpoint is derived server-side.
R2_JURISDICTION=default
# In R2, lock the audit-checkpoints/ prefix indefinitely before production use.

